# Environment Configuration Template for AI Personalized Learning Companion

# App Environment Settings
APP_NAME="AI Personalized Learning Companion"
API_V1_STR="/api/v1"

# Security & JWT Configuration
SECRET_KEY="replace-this-with-a-secure-random-64-character-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 Days

# Database Connection (SQLite default for dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./learning_companion.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/learning_companion_db"

# Google Gemini API Key (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=""

# File Upload Directory
UPLOAD_DIR="./uploads"
